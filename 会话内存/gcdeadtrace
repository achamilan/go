  │        gcDeadFrees     uintptr   // 本周期死亡对象数             │
  │        gcDeadFreeBytes uintptr   // 本周期死亡字节数             │
  │                                                                  │
  │        // (v6: 原 bucket 级会话追踪字段 gcDeadSessionAllocs 等  │
  │        //  已被移除。session 数据完全从会话表汇总。)            │
  │      }                                                          │
